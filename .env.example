# ============================================================
# NextStepKI KI-Betriebssystem – Environment Template
# ============================================================
# Kopiere diese Datei zu `.env` und fülle die Werte aus.
# `.env` wird von git ignoriert.

# ----- Anthropic / Claude -----
ANTHROPIC_API_KEY=sk-ant-...

# Modell-IDs – Defaults aus src/nextstep_os/config.py können hier überschrieben werden
NEXTSTEP_MODEL_OS_AGENT=claude-opus-4-6
NEXTSTEP_MODEL_PIPELINE=claude-sonnet-4-6
NEXTSTEP_MODEL_FAST=claude-haiku-4-5-20251001

# ----- Pfade -----
# Alle Pfade sind relativ zum Projekt-Root, falls nicht absolut.
NEXTSTEP_DATA_DIR=data
NEXTSTEP_PROMPTS_DIR=system_prompts

# ----- MCP-Integrationen (optional) -----
# Gmail MCP – z.B. via Community-Server oder eigener Wrapper
# GMAIL_MCP_URL=http://localhost:8081
# GMAIL_MCP_TOKEN=...

# Google Calendar MCP
# CALENDAR_MCP_URL=http://localhost:8082
# CALENDAR_MCP_TOKEN=...

# CRM (z.B. HubSpot, Notion)
# CRM_MCP_URL=http://localhost:8083
# CRM_MCP_TOKEN=...

# ----- Runtime -----
# Log-Level: DEBUG | INFO | WARNING | ERROR
NEXTSTEP_LOG_LEVEL=INFO

# Token-Budgets pro Kontext-Stufe (Schätzungen, siehe docs/architektur.md)
NEXTSTEP_TOKEN_BUDGET_STUFE_1=6000
NEXTSTEP_TOKEN_BUDGET_STUFE_2=8000
NEXTSTEP_TOKEN_BUDGET_STUFE_3=4000
